plot(hxaAll,YoZoG*1e-9,'bs:','linewidth',1.5);
plot(hxaAll,YeZoG*1e-9,'m^--','linewidth',1);
plot(hxaAll,YoZeG*1e-9,'o-.','linewidth',1,'Color',80/256*[1 1 1]);
% legend({'even','odd','even Y odd Z','odd Y even Z'},'location','southoutside','orientation','horizontal')
xlabel('hx/a'); ylabel('Frequency / GHz');
xlim([min(hxaAll) max(hxaAll)])
saveas(gcf,[datLoc,'sweep.fig']);
saveas(gcf,[datLoc,'sweep.png']);
close

